# Copy to .env and edit:  cp .env.example .env

# --- Model -------------------------------------------------------------------
# Any vLLM-supported Hugging Face vision-language model id.
MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
# Only needed for gated/private models.
HF_TOKEN=

# --- vLLM server -------------------------------------------------------------
# Base vLLM image (vllm/Dockerfile builds on top of it). Pick a tag that matches
# your NVIDIA driver: "-cu129" tags work with driver >= 525 (CUDA 12.x), plain
# tags are CUDA 13 (driver >= 580). v0.30.0-cu129 is broken (ships CUDA 13 torch).
# After changing it, rebuild: docker compose build vllm
VLLM_IMAGE=vllm/vllm-openai:v0.29.0-cu129
# Host folder holding the Hugging Face cache (weights are downloaded here once).
HF_CACHE_DIR=~/.cache/huggingface
VLLM_PORT=8000
# Context length (prompt + image tokens + output). Keep it modest to save VRAM.
MAX_MODEL_LEN=8192
# Fraction of GPU memory vLLM may use.
GPU_MEMORY_UTILIZATION=0.85

# --- Client / batch inference ------------------------------------------------
# Host folders with the images to process and where results are written.
INPUT_DIR=./input
OUTPUT_DIR=./output
# Prompt file (relative to the repo root).
PROMPT_FILE=./prompts/prompt.txt
# Images are downscaled (keeping aspect ratio) to at most this many pixels,
# so large photos fit into MAX_MODEL_LEN. ~1 image token per 32x32 pixels.
MAX_IMAGE_PIXELS=3000000
MAX_TOKENS=1024
TEMPERATURE=0.0
# Host user/group ids that own the output files (see `id -u` / `id -g`).
HOST_UID=1000
HOST_GID=1000
# Parallel requests sent to the server (vLLM batches them on the GPU).
CONCURRENCY=8
